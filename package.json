{
  "name": "dsh-vscode",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness in VS Code: activity-bar launcher, conversations beside the editor, plus editor-title and status-bar entries. Unofficial community extension.",
  "version": "0.5.1",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dsh-vscode.openPanel",
        "title": "DSH: Open Panel",
        "category": "DeepSeek Harness"
      },
      {
        "command": "dsh-vscode.newChat",
        "title": "New Conversation",
        "category": "DeepSeek Harness",
        "icon": {
          "light": "media/dsh.svg",
          "dark": "media/dsh.svg"
        }
      },
      {
        "command": "dsh-vscode.refresh",
        "title": "Refresh Conversations",
        "category": "DeepSeek Harness",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshHarness",
          "title": "DeepSeek Harness",
          "icon": "media/dsh.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dshHarnessSidebar",
          "title": "DeepSeek Harness",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshHarness": [
        {
          "type": "webview",
          "id": "dshHarness.view",
          "name": "Harness"
        }
      ],
      "dshHarnessSidebar": [
        {
          "type": "webview",
          "id": "dshHarness.viewSecondary",
          "name": "Harness"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dshHarness.repoPath": {
          "type": "string",
          "default": "",
          "description": "Optional path of a deepseek-harness checkout; when empty or missing, the extension runs a `dsh` executable from PATH instead."
        },
        "dshHarness.port": {
          "type": "number",
          "default": 3080,
          "description": "Port of the dsh web server."
        },
        "dshHarness.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `dsh web` automatically when it is not running."
        },
        "dshHarness.syncTheme": {
          "type": "boolean",
          "default": true,
          "description": "Write the dsh GUI appearance preference (dark/light) to match the VS Code color theme."
        },
        "dshHarness.command": {
          "type": "string",
          "default": "dsh",
          "description": "Command used to start the web server when no checkout path is configured (e.g. `dsh`, `pnpm dsh`)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "dsh-vscode.newChat",
          "group": "navigation@10",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "dsh-vscode.refresh",
          "group": "navigation",
          "when": "view == dshHarness.view || view == dshHarness.viewSecondary"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3",
    "typescript": "^5"
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ]
}
