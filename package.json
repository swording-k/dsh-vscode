{
  "name": "dsh-vscode",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness in VS Code: activity-bar launcher with conversations opened beside the editor, server auto-start, workspace alignment, and theme sync.",
  "version": "0.3.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dsh-vscode.openPanel",
        "title": "DSH: Open Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshHarness",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dshHarness": [
        {
          "type": "webview",
          "id": "dshHarness.view",
          "name": "Harness"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dshHarness.repoPath": {
          "type": "string",
          "default": "/Users/baojian/Desktop/deepseek-harness-demo/deepseek-harness",
          "description": "Path of the deepseek-harness checkout used to start `dsh web`."
        },
        "dshHarness.port": {
          "type": "number",
          "default": 3080,
          "description": "Port of the dsh web server."
        },
        "dshHarness.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `dsh web` automatically when it is not running."
        },
        "dshHarness.syncTheme": {
          "type": "boolean",
          "default": true,
          "description": "Write the dsh GUI appearance preference (dark/light) to match the VS Code color theme."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3",
    "typescript": "^5"
  }
}
